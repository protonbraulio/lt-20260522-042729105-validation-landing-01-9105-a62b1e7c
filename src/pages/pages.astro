---
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Layout from '@/layouts/Layout.astro'
import generatedPages from '@/config/generated-pages.json'

const pages = generatedPages as Array<{ href: string; title?: string; label?: string }>
---

<Layout>
  <Header />
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <header class="mb-12 space-y-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Pages</p>
      <h1 class="text-4xl font-bold tracking-tight">Pages</h1>
      <p class="text-lg text-muted-foreground">Generated pages and evergreen site information.</p>
    </header>
    {
      pages.length > 0 ? (
        <ul class="grid gap-3 pl-5 list-disc">
          {pages.map((page) => (
            <li>
              <a href={page.href} class="text-primary underline-offset-4 hover:underline">{page.label ?? page.title ?? page.href}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">No generated pages have been added yet.</p>
      )
    }
  </section>
  <Footer />
</Layout>
